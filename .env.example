# ComputingScribe AI - Local Environment Configuration Template

# 1. Direct Gemini API Key (For Guest BYOK Mode)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Google Cloud Configuration (For Enterprise Vertex AI Mode)
GCP_PROJECT_ID=your_gcp_project_id_here
GCP_LOCATION=asia-southeast1
GCS_BUCKET_NAME=your_gcs_bucket_name_here

# 3. Local Auth Fallback (Used for local dev when Secret Manager is not configured)
AUTH_USERS_JSON={"users": {"your_username_here": "your_password_here"}}
AUTH_SECRET_NAME=your_secret_name_here
